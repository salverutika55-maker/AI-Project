generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  FINANCE_MANAGER
  ACCOUNTANT
  STAFF
  READ_ONLY
}

model User {
  id               String                   @id @default(cuid())
  email            String                   @unique
  password         String
  role             String                   @default("USER") // Global platform role (e.g. ADMIN)
  lastLogin        DateTime?
  memberships      OrganizationMembership[]
  auditLogs        AuditLog[]
  tbUploads        TrialBalanceUpload[]
  resolvedAlerts   ComplianceAlert[]
  resolvedScrutinyAlerts ScrutinyAlert[]
  createdAt        DateTime                 @default(now())
}

model Organization {
  id               String                   @id @default(cuid())
  name             String
  members          OrganizationMembership[]
  clients          Client[]                 // The integrations belonging to this Org
  createdAt        DateTime                 @default(now())
}

model OrganizationMembership {
  id               String       @id @default(cuid())
  userId           String
  organizationId   String
  role             Role         @default(STAFF)
  status           String       @default("PENDING") // PENDING, APPROVED, REJECTED
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())

  @@unique([userId, organizationId])
}

model IntegrationCredential {
  id               String       @id @default(cuid())
  clientId         String       @unique
  client           Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  encryptedOauthToken String?      // For Zoho, SAP, etc. (Encrypted)
  encryptedApiKey     String?      // General API Key (Encrypted)
  tallyRefreshToken   String?      // For Tally Connector (Encrypted)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}


enum AccountingSoftware {
  TALLY
  ZOHO
  ODOO
  SAP
  QUICKBOOKS
  XERO
}

enum Sector {
  MANUFACTURING
  TRADING
  SERVICE
}

model Client {
  id                   String            @id @default(cuid())
  name                 String
  organizationId       String
  fiscalYearStartMonth Int               @default(4) // 4 = April, 1 = January
  baseCurrency         String            @default("USD")
  software             AccountingSoftware @default(TALLY)
  sector               Sector            @default(TRADING)
  connectorStatus      String            @default("OFFLINE") // OFFLINE, ONLINE, SYNCING
  lastHeartbeat        DateTime?
  lastSyncedAt         DateTime?
  lastAlterId          String?           @default("0") // Tally's Incremental Marker
  
  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  credentials          IntegrationCredential?
  financialRecords     FinancialRecord[]
  pnlMappings          PNLMapping[]
  pnlValues            PNLValue[]
  budgetMappings       BudgetMapping[]
  budgetValues         BudgetValue[]
  handshakeCodes       HandshakeCode[]
  customSubHeads       CustomSubHead[]
  syncTasks            SyncTask[]
  devices              Device[]
  pairingCodes         PairingCode[]
  tbUploads            TrialBalanceUpload[]
  tallyVouchers        TallyVoucher[]
  complianceRules      ComplianceRule[]
  complianceAlerts     ComplianceAlert[]
  scrutinyRules        ScrutinyRule[]
  scrutinyAlerts       ScrutinyAlert[]
  normalizedLedgers    NormalizedLedger[]
  normalizedVouchers   NormalizedVoucher[]
  reconStates          ReconciliationState[]
  createdAt            DateTime          @default(now())
}

model FinancialRecord {
  id                 String   @id @default(cuid())
  clientId           String
  client             Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  period             String   // e.g., "2024-01", "Q1-2024"
  source             String   @default("CSV") // 'CSV', 'QuickBooks', 'Xero', 'Tally Prime'

  // Income Statement
  revenue            Float    @default(0)
  cogs               Float    @default(0)
  operatingExpenses  Float    @default(0)
  netIncome          Float    @default(0)

  // Balance Sheet
  totalAssets        Float    @default(0)
  currentAssets      Float    @default(0)
  currentLiabilities Float    @default(0)
  totalEquity        Float    @default(0)

  // Cash Flow
  operatingCashFlow  Float    @default(0)
  cashBalance        Float    @default(0)
  burnRate           Float    @default(0)

  // Working Capital
  accountsReceivable Float    @default(0)
  accountsPayable    Float    @default(0)
  inventory          Float    @default(0)

  // Budget
  budgetedRevenue    Float    @default(0)
  budgetedExpenses   Float    @default(0)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([clientId, period])
}

model PNLMapping {
  id                 String   @id @default(cuid())
  clientId           String
  client             Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sectorHead         String   // e.g. "Domestic", "Power Bill"
  softwareLedgerName String   // Name from Zoho/Tally
  source             String   @default("SYNC") // SYNC or UPLOAD
  createdAt          DateTime @default(now())
}

model PNLValue {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  headName   String   // The P&L head name
  month      String   // e.g. "Apr", "May"
  year       Int
  amount     String   // Changed to String to store ENCRYPTED values
  updatedAt  DateTime @updatedAt

  @@unique([clientId, headName, month, year])
}

model BudgetMapping {
  id                 String   @id @default(cuid())
  clientId           String
  client             Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sectorHead         String   // Standard Head
  csvLedgerName      String   // Name from uploaded CSV
  createdAt          DateTime @default(now())
}

model BudgetValue {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  headName   String   // The P&L or BS head name
  month      String   // e.g. "Apr", "May"
  year       Int
  amount     String   // ENCRYPTED values
  updatedAt  DateTime @updatedAt

  @@unique([clientId, headName, month, year])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   // e.g., "SYNC_DATA", "UPDATE_MAPPING", "LOGIN"
  entityId  String?  // The ID of the client or record affected
  details   String?  @db.Text
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique // e.g., "USER_ID:ACTION" or "IP:ACTION"
  count     Int      @default(0)
  resetAt   DateTime
}

model HandshakeCode {
  id        String   @id @default(cuid())
  code      String   @unique // e.g. "A7B-9X2"
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
model CustomSubHead {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String   // e.g. "Travelling Expense"
  headName  String   // e.g. "Indirect Expenses"
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([clientId, name, headName])
}

model SyncTask {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type      String   // e.g., "TALLY_SYNC"
  status    String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  payload   Json?
  result    Json?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, status])
}

model Device {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String   // e.g., "ADITYA-PC"
  deviceId  String   @unique // Machine fingerprint
  token            String   @unique // Encrypted device token (Legacy or Machine ID)
  refreshToken     String?  @unique // Opaque refresh token for persistent sessions
  refreshExpiresAt DateTime?
  status           String   @default("ACTIVE") // ACTIVE, REVOKED
  lastSeen         DateTime @default(now())
  createdAt        DateTime @default(now())
}

model PairingCode {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  code      String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Extend Device model for persistent sessions
// (Note: We use multi_replace to merge this into the existing model)
model TrialBalanceUpload {
  id              String    @id @default(cuid())
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fileName        String
  fileSize        Int
  status          String    @default("PROCESSING") // PROCESSING, MAPPING_REQUIRED, COMPLETED, FAILED
  detectedFormat  Json?     // Stores column indices for Ledger, Dr, Cr
  period          String    // e.g. "2024-03"
  uploadedById    String
  uploadedBy      User      @relation(fields: [uploadedById], references: [id])
  createdAt       DateTime  @default(now())
  
  rawRecords      RawLedgerRecord[]
}

model RawLedgerRecord {
  id               String             @id @default(cuid())
  uploadId         String
  upload           TrialBalanceUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  ledgerName       String
  groupName        String?
  debit            Float              @default(0)
  credit           Float              @default(0)
  balance          Float              @default(0)
  isMapped         Boolean            @default(false)
  suggestedHead    String?            // AI predicted mapping
  confidence       Float?             // AI confidence score
}

model TallyVoucher {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  tallyGuid   String   @unique // Tally's unique voucher ID
  alterId     Int      // To track the version
  date        DateTime
  voucherType String
  ledgerName  String
  amount      Float
  isDebit     Boolean
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId, date])
}

model ComplianceRule {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category       String   // "TDS", "DEPRECIATION", "PREPAID"
  ruleCode       String   // e.g. "TDS_RATE_CHECK", "DEP_MONTHLY_CHECK"
  name           String
  description    String
  config         Json     // Configurable parameters (e.g. TDS rate thresholds, FA ledger prefixes)
  isActive       Boolean  @default(true)
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([clientId, ruleCode])
}

model ComplianceAlert {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category       String   // "TDS", "DEPRECIATION", "PREPAID"
  severity       String   // "HIGH", "MEDIUM", "LOW"
  title          String
  description    String
  ledgerName     String?  // Affected ledger
  voucherId      String?  // Reference voucher if applicable
  impactAmount   Float    @default(0)
  status         String   @default("PENDING") // PENDING, UNDER_REVIEW, RESOLVED, MUTED
  commentary     String?  @db.Text
  resolvedById   String?
  resolvedBy     User?    @relation(fields: [resolvedById], references: [id])
  metadata       Json?    // Detailed audit sequence trace
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([clientId, category, status])
}

model NormalizedLedger {
  id             String                @id @default(cuid())
  clientId       String
  client         Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name           String
  groupName      String                // e.g. "Fixed Assets", "Indirect Expenses", "Duties & Taxes"
  openingBalance Float                 @default(0.0)
  closingBalance Float                 @default(0.0)
  nature         String                // DEBIT, CREDIT
  isActive       Boolean               @default(true)
  
  voucherLines   NormalizedVoucherLine[]
  alerts         ScrutinyAlert[]
  
  @@unique([clientId, name])
  @@index([clientId, groupName])
}

model NormalizedVoucher {
  id             String                @id @default(cuid())
  clientId       String
  client         Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  voucherNumber  String
  date           DateTime
  type           String                // JOURNAL, PAYMENT, RECEIPT, CONTRA, PURCHASE, SALES
  narration      String?               @db.Text
  totalAmount    Float
  referenceNo    String?
  isManual       Boolean               @default(false)
  
  lines          NormalizedVoucherLine[]
  alerts         ScrutinyAlert[]
  
  createdAt      DateTime              @default(now())
  
  @@index([clientId, date])
  @@index([clientId, type])
}

model NormalizedVoucherLine {
  id                  String            @id @default(cuid())
  voucherId           String
  voucher             NormalizedVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  ledgerId            String
  ledger              NormalizedLedger  @relation(fields: [ledgerId], references: [id])
  amount              Float             // Positive for Debit, Negative for Credit
  entryType           String            // DEBIT, CREDIT
  
  @@index([voucherId])
  @@index([ledgerId])
}

model ScrutinyRule {
  id             String                @id @default(cuid())
  clientId       String
  client         Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  code           String                // e.g., "ACC_FLOW_BYPASS", "STATUTORY_PF_LIMIT"
  name           String
  category       String                // FLOW, CLASSIFICATION, STATUTORY, TIMING, FORENSIC
  description    String
  config         Json                  // Rule-specific parameters (e.g. rate tolerances, keywords)
  severity       String                // HIGH, MEDIUM, LOW
  isActive       Boolean               @default(true)
  
  @@unique([clientId, code])
}

model ScrutinyAlert {
  id             String                @id @default(cuid())
  clientId       String
  client         Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ruleCode       String
  category       String
  severity       String                // HIGH, MEDIUM, LOW
  title          String
  description    String                @db.Text
  ledgerId       String?
  ledger         NormalizedLedger?     @relation(fields: [ledgerId], references: [id])
  voucherId      String?
  voucher        NormalizedVoucher?    @relation(fields: [voucherId], references: [id])
  impactAmount   Float                 @default(0.0)
  status         String                @default("PENDING") // PENDING, UNDER_REVIEW, RESOLVED, MUTED
  commentary     String?               @db.Text
  resolvedById   String?
  resolvedBy     User?                 @relation(fields: [resolvedById], references: [id])
  metadata       Json?                 // Technical details, execution logs, and timelines
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  
  @@index([clientId, category, status])
  @@index([clientId, severity])
}

model ReconciliationState {
  id             String                @id @default(cuid())
  clientId       String
  client         Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type           String                // BANK, GST_2B, GST_1
  statementPeriod String               // "2026-05"
  mismatchAmount Float                 @default(0.0)
  lastRun        DateTime              @default(now())
  metadata       Json?                 // Reconciliation parameters and match logs
}
